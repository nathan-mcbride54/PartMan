        "surface.raised": "#0A0A0A",
        "surface.overlay": "#141414",
        "text.primary": "#FFFFFF",
        "text.secondary": "#F0F0F0",
        "text.muted": "#D8D8D8",
        "border.default": "#B0B0B0",
        "border.strong": "#FFFFFF",
        "focus.ring": "#7FD4FF",
        "entity.device": "#9CCBFF",
        "entity.partition": "#8BEFB4",
        "entity.container": "#DCBBFF",
        "entity.volume": "#8CE8ED",
        "entity.encryption": "#FFD98A",
        "entity.filesystem": "#C3D4E8",
        "entity.mount": "#A0F0CB",
        "entity.freeSpace": "#9AA3B2",
        "severity.informational": "#BBD3F0",
        "severity.reversible": "#A8F5D0",
        "severity.disruptive": "#FFE08A",
        "severity.dataMoving": "#FF9A55",
        "severity.destructive": "#F07070",
        "progress.planning": "#BBD3F0",
