  "themeSignals": {
    "defaultTheme": "dark",
    "systemSelectionLabelId": "theme.system",
    "systemColorScheme": {
      "unknown": "dark",
      "light": "light",
      "dark": "dark"
    },
    "highContrastTheme": "high-contrast"
  },

  "typography": {
    "families": {
      "platform-ui": {
        "strategy": "platform-default"
      }
    },
    "styles": {
      "body": {
        "family": "platform-ui",
        "sizePx": 16,
        "weight": 400,
        "italic": false,
        "letterSpacingMilliPx": 0,
        "lineHeightPermille": 1500
      },
      "body-small": {
        "family": "platform-ui",
        "sizePx": 14,
        "weight": 400,
        "italic": false,
        "letterSpacingMilliPx": 0,
        "lineHeightPermille": 1500
      },
      "caption": {
        "family": "platform-ui",
        "sizePx": 12,
        "weight": 400,
        "italic": false,
        "letterSpacingMilliPx": 0,
        "lineHeightPermille": 1500
      },
      "heading": {
        "family": "platform-ui",
        "sizePx": 16,
        "weight": 700,
        "italic": false,
        "letterSpacingMilliPx": 0,
        "lineHeightPermille": 1250
      },
      "title": {
        "family": "platform-ui",
        "sizePx": 18,
        "weight": 700,
        "italic": false,
        "letterSpacingMilliPx": -360,
        "lineHeightPermille": 1200
      },
      "eyebrow": {
        "family": "platform-ui",
        "sizePx": 11,
        "weight": 700,
        "italic": false,
        "letterSpacingMilliPx": 1000,
        "lineHeightPermille": 1200
      },
      "exact-value": {
        "family": "platform-ui",
        "sizePx": 12,
        "weight": 400,
        "italic": false,
        "letterSpacingMilliPx": 0,
        "lineHeightPermille": 1500
      }
    },
    "flows": {
      "single-line": {
        "wrap": "no-wrap",
        "overflow": "elide",
        "horizontalAlignment": "left",
        "verticalAlignment": "center"
      },
      "multi-line": {
        "wrap": "word-wrap",
        "overflow": "clip",
        "horizontalAlignment": "left",
        "verticalAlignment": "top"
      }
    },
    "textInput": {
      "style": "body",
      "flow": "single-line",
      "selectionPair": {
        "foreground": "surface.sunken",
        "background": "focus.ring"
      }
    }
  },

  "layout": {
    "spacingPx": {
      "none": 0,
      "xs": 4,
      "sm": 8,
      "md": 12,
      "lg": 16,
      "xl": 24,
      "xxl": 32
    },
    "radiusPx": {
      "none": 0,
      "sm": 4,
      "md": 8,
      "lg": 14,
      "pill": 999
    },
    "strokePx": {
      "hairline": 1,
      "strong": 2,
      "focus": 3
    },
    "defaultLayoutPadding": "md",
    "defaultLayoutSpacing": "sm",
    "focusRingOffsetPx": 3,
    "minimumTargetSizePx": 44
  },

  "cursors": {
    "textCaretWidthPx": 2,
    "roles": {
      "default": "default",
      "action": "pointer",
      "disabled": "not-allowed",
      "text": "text"
    }
  },

  "contrastRules": {
    "note": "WCAG 2.2. 'text' is Success Criterion 1.4.3 Contrast (Minimum) at AA: 4.5:1 for normal text. 'ui' is 1.4.11 Non-text Contrast: 3:1 for user-interface components and graphical objects. A role listed as 'ui' MUST NOT be used to render normal-size text, and that restriction is the reason its threshold is lower.",
    "thresholds": { "text": 4.5, "ui": 3.0 },
    "pairings": [
      { "foreground": "text.primary", "background": "surface.base", "kind": "text" },
      { "foreground": "text.primary", "background": "surface.raised", "kind": "text" },
      { "foreground": "text.primary", "background": "surface.overlay", "kind": "text" },
      { "foreground": "text.primary", "background": "surface.sunken", "kind": "text" },
      { "foreground": "text.secondary", "background": "surface.base", "kind": "text" },
      { "foreground": "text.secondary", "background": "surface.raised", "kind": "text" },
      { "foreground": "text.muted", "background": "surface.base", "kind": "text" },
      { "foreground": "text.muted", "background": "surface.raised", "kind": "text" },

      { "foreground": "border.default", "background": "surface.base", "kind": "ui" },
      { "foreground": "border.strong", "background": "surface.base", "kind": "ui" },
      { "foreground": "focus.ring", "background": "surface.base", "kind": "ui" },
      { "foreground": "focus.ring", "background": "surface.raised", "kind": "ui" },
      { "foreground": "surface.sunken", "background": "focus.ring", "kind": "text" },

      { "foreground": "entity.device", "background": "surface.base", "kind": "text" },
      { "foreground": "entity.partition", "background": "surface.base", "kind": "text" },
      { "foreground": "entity.container", "background": "surface.base", "kind": "text" },
      { "foreground": "entity.volume", "background": "surface.base", "kind": "text" },
      { "foreground": "entity.encryption", "background": "surface.base", "kind": "text" },
      { "foreground": "entity.filesystem", "background": "surface.base", "kind": "text" },
      { "foreground": "entity.mount", "background": "surface.base", "kind": "text" },
      { "foreground": "entity.freeSpace", "background": "surface.base", "kind": "ui" },

      { "foreground": "severity.informational", "background": "surface.base", "kind": "text" },
      { "foreground": "severity.reversible", "background": "surface.base", "kind": "text" },
      { "foreground": "severity.disruptive", "background": "surface.base", "kind": "text" },
      { "foreground": "severity.dataMoving", "background": "surface.base", "kind": "text" },
      { "foreground": "severity.destructive", "background": "surface.base", "kind": "text" },
      { "foreground": "severity.destructive", "background": "surface.raised", "kind": "text" },

      { "foreground": "progress.planning", "background": "surface.base", "kind": "text" },
      { "foreground": "progress.awaitingAuthorization", "background": "surface.base", "kind": "text" },
      { "foreground": "progress.executing", "background": "surface.base", "kind": "text" },
      { "foreground": "progress.verifying", "background": "surface.base", "kind": "text" },
      { "foreground": "progress.rebootPending", "background": "surface.base", "kind": "text" },
      { "foreground": "progress.recovering", "background": "surface.base", "kind": "text" },
      { "foreground": "progress.failed", "background": "surface.base", "kind": "text" },
      { "foreground": "progress.complete", "background": "surface.base", "kind": "text" }
    ]
  },

  "nonColorChannels": {
    "note": "UI-007: colour is never the only carrier for the 21 declared entity, risk-severity, and progress-state roles. Every role below declares the redundant channels that a front end must resolve and render together. Selection and health still require separate shell evidence. This table is the canonical requirement, not proof that a catalogue or renderer fulfilled it; the colour-vision simulation remains only a smell test.",
    "roles": {
      "entity.device": { "icon": "drive", "labelId": "meaning.entity.device", "shape": "rect-square" },
      "entity.partition": { "icon": "slice", "labelId": "meaning.entity.partition", "shape": "rect-notched" },
      "entity.container": { "icon": "box", "labelId": "meaning.entity.container", "shape": "rect-double" },
      "entity.volume": { "icon": "layers", "labelId": "meaning.entity.volume", "shape": "rect-rounded" },
      "entity.encryption": { "icon": "lock", "labelId": "meaning.entity.encryption", "shape": "badge-lock" },
      "entity.filesystem": { "icon": "file-tree", "labelId": "meaning.entity.filesystem", "shape": "rect-plain" },
      "entity.mount": { "icon": "link", "labelId": "meaning.entity.mount", "shape": "badge-link" },
      "entity.freeSpace": { "icon": "dashed", "labelId": "meaning.entity.freeSpace", "shape": "rect-dashed" },

      "severity.informational": { "icon": "info", "labelId": "meaning.severity.informational", "shape": "dot" },
      "severity.reversible": { "icon": "undo", "labelId": "meaning.severity.reversible", "shape": "dot" },
      "severity.disruptive": { "icon": "pause-octagon", "labelId": "meaning.severity.disruptive", "shape": "chevron" },
      "severity.dataMoving": { "icon": "arrows-shuffle", "labelId": "meaning.severity.dataMoving", "shape": "chevron-double" },
      "severity.destructive": { "icon": "triangle-exclamation", "labelId": "meaning.severity.destructive", "shape": "triangle" },

      "progress.planning": { "icon": "compass", "labelId": "meaning.progress.planning", "shape": "dot" },
      "progress.awaitingAuthorization": { "icon": "shield-question", "labelId": "meaning.progress.awaitingAuthorization", "shape": "dot-hollow" },
      "progress.executing": { "icon": "play", "labelId": "meaning.progress.executing", "shape": "bar-active" },
      "progress.verifying": { "icon": "magnifier-check", "labelId": "meaning.progress.verifying", "shape": "bar-check" },
      "progress.rebootPending": { "icon": "power-cycle", "labelId": "meaning.progress.rebootPending", "shape": "dot-hollow" },
      "progress.recovering": { "icon": "life-ring", "labelId": "meaning.progress.recovering", "shape": "bar-warn" },
      "progress.failed": { "icon": "circle-cross", "labelId": "meaning.progress.failed", "shape": "cross" },
      "progress.complete": { "icon": "circle-check", "labelId": "meaning.progress.complete", "shape": "check" }
    }
  },

  "colorVisionSeparation": {
    "note": "A smell test, not a proof. Roles whose confusion would mislead a user about risk are simulated under three colour-vision deficiencies and required to stay apart by a CIE76 delta-E floor. Passing is NOT evidence that two colours are distinguishable in practice -- CIE76 is the crudest of the delta-E formulae and the simulation is a model. The guarantee lives in nonColorChannels; this check exists to catch the case where two roles collapse to the same colour, which is a design mistake worth failing a build over.",
    "minimumDeltaE": 12.0,
    "mustRemainDistinct": [
      ["severity.reversible", "severity.destructive"],
      ["severity.reversible", "severity.dataMoving"],
      ["severity.disruptive", "severity.destructive"],
      ["severity.informational", "severity.destructive"],
      ["progress.complete", "progress.failed"],
      ["progress.executing", "progress.failed"],
      ["progress.complete", "progress.recovering"]
    ]
  }
}
