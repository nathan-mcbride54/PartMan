{
  "tokenSetVersion": "2.0.0",
  "specVersion": "4.0.0",
  "note": "Single source of truth for PartMan's renderer-neutral visual language. The accessibility harness in crates/tokens reads this file; every front end MUST consume this same contract rather than keeping its own copy. An implementation checked against a table it also owns proves only self-consistency.",

  "measurementUnits": {
    "px": "logical-pixel",
    "letterSpacingMilliPx": "thousandths-of-logical-pixel",
    "lineHeightPermille": "thousandths-of-font-size"
  },

