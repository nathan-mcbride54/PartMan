# Anchored to the root AND matched at any depth. A bare '/target/' misses the
# build output of every nested crate, which is how ~200 build artifacts once
# reached a commit.
/target/
target/
node_modules/
/.idea/
/.vscode/
*.swp
*.tmp
*.log

# Generated disposable disk fixtures are never committed (SAFE-001, Section 11.3).
/tests/generated/
*.img
*.raw
*.vhd
*.vhdx
*.qcow2

# Local secrets and signing material must never enter the repository.
.env
.env.*
*.key
*.p12
*.pfx

# Operator sitting captures. `docs/quality/observability.md` requires the raw
# transcript to be retained OUTSIDE the repository, with only normalized
# observations committed — these drops carry machine-specific identifiers and
# raw diagnostic output, which that custody rule keeps out by name. A capture
# left in the working tree after a sitting is a `git add .` away from becoming
# a commit; on 2026-08-05 a macOS drop sat untracked and unignored in the root
# for exactly that window. Matched at any depth, for the reason `/target/`
# already records above.
mac-tests/
out-pre/
out-post/
partman-*-sitting*/

